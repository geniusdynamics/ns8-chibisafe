# Chibisafe routing, as in the upstream setup: uploaded files, the API and
# the API docs go to the server, everything else to the web application.
# Traefik terminates TLS and forwards plain HTTP to port 8080 of the pod.
{
	auto_https off
	admin off
}

:8080 {
	route {
		file_server * {
			root /app/uploads
			pass_thru
		}

		@api path /api/*
		reverse_proxy @api http://127.0.0.1:8000 {
			header_up X-Real-IP {http.request.header.X-Real-IP}
		}

		@docs path /docs*
		reverse_proxy @docs http://127.0.0.1:8000 {
			header_up X-Real-IP {http.request.header.X-Real-IP}
		}

		reverse_proxy http://127.0.0.1:8001 {
			header_up X-Real-IP {http.request.header.X-Real-IP}
		}
	}
}
